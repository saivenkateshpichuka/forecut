rules_version = '2';
// Forecut Firestore rules: feedback, personal cloud sync (Stage 12) and teams.
// Publish in Firebase console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function teamData(t) { return get(/databases/$(database)/documents/teams/$(t)).data; }

    // feedback form: anyone signed in can send their own feedback; nobody can read it from the site
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // personal sync: each person can only read and write their own copy
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // teams: owner manages members and invites; an invited person can add only themselves with the invited role;
    // a member can leave; members read shared styles; owners and editors share and update them
    match /teams/{t} {
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members[request.auth.uid] == 'owner';
      allow read: if signedIn() && (request.auth.uid in resource.data.memberIds
        || (request.auth.token.email != null && myEmail() in resource.data.inviteEmails));
      allow update: if signedIn() && (
        (resource.data.members[request.auth.uid] == 'owner' && request.resource.data.owner == resource.data.owner)
        || (request.auth.token.email != null && myEmail() in resource.data.inviteEmails
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds', 'names', 'emails', 'inviteEmails', 'invites'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.members[request.auth.uid] == resource.data.invites[myEmail()]
            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.auth.uid].toSet())
        || (request.auth.uid in resource.data.memberIds && resource.data.members[request.auth.uid] != 'owner'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds'])
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]))
      );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /styles/{s}/{document=**} {
        allow read: if signedIn() && request.auth.uid in teamData(t).memberIds;
        allow write: if signedIn() && teamData(t).members[request.auth.uid] in ['owner', 'editor'];
      }
    }
  }
}
