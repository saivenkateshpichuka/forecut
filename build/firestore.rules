rules_version = '2';
// Forecut Firestore rules: feedback, personal cloud sync (Stage 12) and teams.
// Publish in Firebase console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function teamData(t) { return get(/databases/$(database)/documents/teams/$(t)).data; }
    // the owner is listed in admins/{uid} (created by hand in the Firebase console; nobody can write it from the site)
    function codeGives(c, d) {
      let k = get(/databases/$(database)/documents/codes/$(c)).data;
      return k.active == true && d.plan == k.plan && d.until == k.until && (k.closesMs == 0 || request.time.toMillis() <= k.closesMs);
    }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // member profile: each person writes only their own; the owner reads all on the admin page
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'provider', 'verified', 'created', 'lastSeen', 'lastPage', 'source', 'landing'])
        && (request.auth.token.email == null || request.resource.data.email == request.auth.token.email.lower());
      // the owner can bring in members who signed up before profiles existed (Import from Firebase on the admin page)
      allow create: if isAdmin() && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'provider', 'verified', 'created', 'lastSeen', 'lastPage', 'source', 'landing']);
      allow delete: if isAdmin();
    }

    // access granted by the owner (student, alumni, partner...): members read their own, only the owner writes
    match /access/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
      // a member can switch on their own access with a valid code, only to what the code gives, and never shorten what they have
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['plan', 'until', 'note', 'by', 'at', 'code'])
        && request.resource.data.by == uid
        && codeGives(request.resource.data.code, request.resource.data)
        && (resource == null || (resource.data.until != '' && (request.resource.data.until == '' || resource.data.until < request.resource.data.until)));
    }

    // access codes: made on the admin page; a signed-in member can look up one code by name, never list them
    match /codes/{c} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    // access requests from the account page: one per member, reviewed by the owner
    match /requests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid && request.resource.data.status == 'new'
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'role', 'college', 'course', 'year', 'message', 'at', 'status'])
        && (resource == null || resource.data.status != 'approved');
      allow update, delete: if isAdmin();
    }

    // the owner's tags, notes and history for each member, and the log of emails sent: admin only
    match /crm/{uid} { allow read, write: if isAdmin(); }
    match /mails/{id} { allow read, write: if isAdmin(); }

    // site settings such as the announcement banner: everyone can read, only the owner changes them
    match /config/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // feedback form: anyone signed in can send their own feedback; only the owner can read it
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // personal sync: each person can only read and write their own copy
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // teams: owner manages members and invites; an invited person can add only themselves with the invited role;
    // a member can leave; members read shared styles; owners and editors share and update them
    match /teams/{t} {
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members[request.auth.uid] == 'owner';
      allow read: if signedIn() && (request.auth.uid in resource.data.memberIds
        || (request.auth.token.email != null && myEmail() in resource.data.inviteEmails));
      allow update: if signedIn() && (
        (resource.data.members[request.auth.uid] == 'owner' && request.resource.data.owner == resource.data.owner)
        || (request.auth.token.email != null && myEmail() in resource.data.inviteEmails
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds', 'names', 'emails', 'inviteEmails', 'invites'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.members[request.auth.uid] == resource.data.invites[myEmail()]
            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.auth.uid].toSet())
        || (request.auth.uid in resource.data.memberIds && resource.data.members[request.auth.uid] != 'owner'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds'])
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]))
      );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /styles/{s}/{document=**} {
        allow read: if signedIn() && request.auth.uid in teamData(t).memberIds;
        allow write: if signedIn() && teamData(t).members[request.auth.uid] in ['owner', 'editor'];
      }
    }
  }
}
